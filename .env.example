# Required — Supabase project (Singapore region for PH latency)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used by /api/admin/invite to create users and by /admin/users to list profiles.
# DO NOT expose this to the browser. Only set in server-side env (Vercel project, .env.local).
SUPABASE_SERVICE_ROLE_KEY=

# Required — Claude API for /insights AI features (weekly review, anomalies, Monday digest)
ANTHROPIC_API_KEY=
